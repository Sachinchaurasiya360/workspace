generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccessLevel {
  TASK_BASED
  SALES_BASED
  ADMIN
  ADMIN_TASK_BASED
  SALES_TASK_BASED
  ENGINEERING
  ADMIN_SALES_BASED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  PENDING_APPROVAL
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
}

/// The user as a participant: signed up, then attended.
enum EventParticipation {
  REGISTERED
  ATTENDED
}

/// The user as an organiser: planning it, then ran it.
enum EventExecution {
  IN_PLAN
  CONDUCTED
}

enum ApprovalStatus {
  REQUEST_RAISED
  APPROVED
  REJECTED
  DISCUSS
  CANCELLED
}

enum ApprovalType {
  TASK_COMPLETION
  EVENT_ATTENDANCE
}

enum KpiMetric {
  CALLS
  DISCOVERY
  PROFILES
  FOLLOW_UPS
  MEETINGS
  DEALS_CLOSED
  EVENTS_ATTENDED
  EVENTS_CONDUCTED
  TASKS_COMPLETED
}

enum LeadStage {
  NEW
  CONTACTED
  MEETING
  PROPOSAL
  WON
  LOST
}

enum LeadActivityType {
  CALL
  FOLLOW_UP
  MEETING
  NOTE
}

enum CommentEntityType {
  TASK
  PROJECT
  EVENT
}

model User {
  id                 String      @id @default(cuid())
  name               String
  email              String      @unique
  passwordHash       String
  mustChangePassword Boolean     @default(true)
  // Bumped on password reset/change; JWTs carrying an older value are rejected.
  sessionVersion     Int         @default(0)
  role               String
  phone              String?
  isFounder          Boolean     @default(false)
  access             AccessLevel @default(TASK_BASED)
  notes              String?
  isActive           Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  tasksAssigned      Task[]          @relation("TaskAssignee")
  tasksCreated       Task[]          @relation("TaskCreatedBy")
  projectsLed        Project[]       @relation("ProjectLead")
  projectsCreated    Project[]       @relation("ProjectCreatedBy")
  eventOverviews     EventOverview[]
  approvalsRequested Approval[]      @relation("ApprovalRequestedBy")
  approvalsActedOn   Approval[]      @relation("ApprovalApprovedBy")
  kpiTargets         KpiTarget[]
  dailyLogs          DailyLog[]
  comments           Comment[]
  auditLogs          AuditLog[]
  notifications      Notification[]
  projectsMember     Project[]       @relation("ProjectMembers")
  leadsOwned         Lead[]          @relation("LeadOwner")
  leadActivities     LeadActivity[]

  @@index([email])
}

model Project {
  id            String        @id @default(cuid())
  projectCode   String        @unique
  name          String
  department    String?
  leadId        String?
  lead          User?         @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  overallStatus ProjectStatus @default(NOT_STARTED)
  targetMonth   String?
  startDate     DateTime?
  dueDate       DateTime?
  notes         String?
  createdById   String?
  createdBy     User?         @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // transient — used only during the one-time legacy data migration, dropped afterwards
  legacyRowRef Int?

  tasks    Task[]
  comments Comment[] @relation("ProjectComments")
  members  User[]    @relation("ProjectMembers")
  leads    Lead[]

  @@index([leadId])
}

model Task {
  id                    String       @id @default(cuid())
  title                 String
  description           String?
  projectId             String?
  project               Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  unresolvedProjectName String?
  assigneeId            String
  assignee              User         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  status                TaskStatus   @default(TODO)
  priority              TaskPriority @default(MEDIUM)
  dueDate               DateTime?
  // When the task last became COMPLETED (null while open) — KPIs count on this, not updatedAt.
  completedAt           DateTime?
  createdById           String?
  createdBy             User?        @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  // transient — used only during the one-time legacy data migration, dropped afterwards
  legacyRowRef Int?

  approvals Approval[]
  comments  Comment[]  @relation("TaskComments")
  // Optional sales context: a follow-up task created from a lead.
  leadId    String?
  lead      Lead?      @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([assigneeId, status])
  @@index([projectId])
}

model Event {
  id                   String    @id @default(cuid())
  city                 String?
  name                 String
  date                 DateTime?
  time                 String?
  venue                String?
  registrationStatus   String?
  registrationDeadline DateTime?
  targetAudience       String?
  keyHighlights        String?
  price                String?
  link                 String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // transient — used only during the one-time legacy data migration, dropped afterwards
  legacyRowRef Int?

  eventOverviews EventOverview[]
  approvals      Approval[]
  comments       Comment[]       @relation("EventComments")
}

model EventOverview {
  id            String              @id @default(cuid())
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId       String
  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // Tracked independently: someone can attend an event *and* help run it.
  participation EventParticipation?
  execution     EventExecution?
  // When each milestone happened — the event KPIs count on these.
  attendedAt    DateTime?
  conductedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([userId, eventId])
}

model Approval {
  id            String         @id @default(cuid())
  type          ApprovalType
  status        ApprovalStatus @default(REQUEST_RAISED)
  requestedById String?
  requestedBy   User?          @relation("ApprovalRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedById  String?
  approvedBy    User?          @relation("ApprovalApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  comment       String?
  requestNote   String?
  taskId        String?
  task          Task?          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  eventId       String?
  event         Event?         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
  resolvedAt    DateTime?

  @@index([status, type])
  @@index([taskId])
  @@index([eventId])
}

model KpiTarget {
  id     String    @id @default(cuid())
  userId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kpi    KpiMetric
  target Int
  period String
  weight Float?

  @@unique([userId, kpi, period])
}

model DailyLog {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  callsMade       Int      @default(0)
  followUps       Int      @default(0)
  dealsClosed     Int      @default(0)
  meetings        Int      @default(0)
  outboundReach   Int      @default(0)
  discoveryDemos  Int      @default(0)
  profilesSignups Int      @default(0)
  activitiesHtml  String?
  // [{ taskId, title, status }] snapshot of tasks touched in this update
  taskUpdates     Json?
  // [{ eventId, name, change: "ATTENDED" | "CONDUCTED" }] recorded with this update
  eventUpdates    Json?
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
}

model Comment {
  id             String            @id @default(cuid())
  entityType     CommentEntityType
  taskId         String?
  task           Task?             @relation("TaskComments", fields: [taskId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?          @relation("ProjectComments", fields: [projectId], references: [id], onDelete: Cascade)
  eventId        String?
  event          Event?            @relation("EventComments", fields: [eventId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  body           String
  isLegacyImport Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([taskId])
  @@index([projectId])
  @@index([eventId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model Lead {
  id           String    @id @default(cuid())
  name         String
  company      String?
  email        String?
  phone        String?
  stage        LeadStage @default(NEW)
  value        Int?
  source       String?
  nextFollowUp DateTime?
  notes        String?
  ownerId      String
  owner        User      @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  activities LeadActivity[]
  tasks      Task[]
  // The initiative this prospect belongs to, if any.
  projectId  String?
  project    Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([ownerId, stage])
}

model LeadActivity {
  id        String           @id @default(cuid())
  leadId    String
  lead      Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      LeadActivityType
  note      String?
  createdAt DateTime         @default(now())

  @@index([leadId])
  @@index([userId, createdAt])
}
