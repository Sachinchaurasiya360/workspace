generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccessLevel {
  TASK_BASED
  SALES_BASED
  ADMIN
  ADMIN_TASK_BASED
  SALES_TASK_BASED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  PENDING_APPROVAL
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
}

enum EventOverviewStatus {
  IN_PLAN
  REGISTERED
  ATTENDED
  CONDUCTED
}

enum ApprovalStatus {
  REQUEST_RAISED
  APPROVED
  REJECTED
  DISCUSS
}

enum ApprovalType {
  TASK_COMPLETION
  EVENT_ATTENDANCE
}

enum KpiMetric {
  CALLS
  DISCOVERY
  PROFILES
  FOLLOW_UPS
  DEALS_CLOSED
  EVENTS_ATTENDED
  EVENTS_CONDUCTED
  TASKS_COMPLETED
}

enum CommentEntityType {
  TASK
  PROJECT
  EVENT
}

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  passwordHash       String
  mustChangePassword Boolean  @default(true)
  role               String
  isFounder          Boolean  @default(false)
  access             AccessLevel @default(TASK_BASED)
  notes              String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tasksAssigned      Task[]          @relation("TaskAssignee")
  tasksCreated       Task[]          @relation("TaskCreatedBy")
  projectsLed        Project[]       @relation("ProjectLead")
  projectsCreated    Project[]       @relation("ProjectCreatedBy")
  eventOverviews     EventOverview[]
  approvalsRequested Approval[]      @relation("ApprovalRequestedBy")
  approvalsActedOn   Approval[]      @relation("ApprovalApprovedBy")
  kpiTargets         KpiTarget[]
  dailyLogs          DailyLog[]
  comments           Comment[]
  auditLogs          AuditLog[]

  @@index([email])
}

model Project {
  id            String        @id @default(cuid())
  projectCode   String        @unique
  name          String
  department    String?
  leadId        String?
  lead          User?         @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  overallStatus ProjectStatus @default(NOT_STARTED)
  targetMonth   String?
  startDate     DateTime?
  dueDate       DateTime?
  notes         String?
  createdById   String?
  createdBy     User?         @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // transient — used only during the one-time legacy data migration, dropped afterwards
  legacyRowRef Int?

  tasks    Task[]
  comments Comment[] @relation("ProjectComments")

  @@index([leadId])
}

model Task {
  id                    String       @id @default(cuid())
  title                 String
  description           String?
  projectId             String?
  project               Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  unresolvedProjectName String?
  assigneeId            String
  assignee              User         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  status                TaskStatus   @default(TODO)
  priority              TaskPriority @default(MEDIUM)
  dueDate               DateTime?
  createdById           String?
  createdBy             User?        @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  // transient — used only during the one-time legacy data migration, dropped afterwards
  legacyRowRef Int?

  approvals Approval[]
  comments  Comment[]  @relation("TaskComments")

  @@index([assigneeId, status])
  @@index([projectId])
}

model Event {
  id                   String    @id @default(cuid())
  city                 String?
  name                 String
  date                 DateTime?
  time                 String?
  venue                String?
  registrationStatus   String?
  registrationDeadline DateTime?
  targetAudience       String?
  keyHighlights        String?
  price                String?
  link                 String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // transient — used only during the one-time legacy data migration, dropped afterwards
  legacyRowRef Int?

  eventOverviews EventOverview[]
  approvals      Approval[]
  comments       Comment[] @relation("EventComments")
}

model EventOverview {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String
  event     Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  status    EventOverviewStatus @default(IN_PLAN)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([userId, eventId])
}

model Approval {
  id            String         @id @default(cuid())
  type          ApprovalType
  status        ApprovalStatus @default(REQUEST_RAISED)
  requestedById String
  requestedBy   User           @relation("ApprovalRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedById  String?
  approvedBy    User?          @relation("ApprovalApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  comment       String?
  taskId        String?
  task          Task?          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  eventId       String?
  event         Event?         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
  resolvedAt    DateTime?

  @@index([status, type])
  @@index([taskId])
  @@index([eventId])
}

model KpiTarget {
  id     String    @id @default(cuid())
  userId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kpi    KpiMetric
  target Int
  period String
  weight Float?

  @@unique([userId, kpi, period])
}

model DailyLog {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  callsMade       Int      @default(0)
  followUps       Int      @default(0)
  dealsClosed     Int      @default(0)
  meetings        Int      @default(0)
  outboundReach   Int      @default(0)
  discoveryDemos  Int      @default(0)
  profilesSignups Int      @default(0)
  activitiesHtml  String?
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
}

model Comment {
  id             String            @id @default(cuid())
  entityType     CommentEntityType
  taskId         String?
  task           Task?             @relation("TaskComments", fields: [taskId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?          @relation("ProjectComments", fields: [projectId], references: [id], onDelete: Cascade)
  eventId        String?
  event          Event?            @relation("EventComments", fields: [eventId], references: [id], onDelete: Cascade)
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  body           String
  isLegacyImport Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([taskId])
  @@index([projectId])
  @@index([eventId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}
